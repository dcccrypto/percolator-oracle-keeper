# Required
RPC_URL=https://api.devnet.solana.com
# Optional secondary HTTPS RPC endpoint for transaction-inclusion verification
VERIFY_RPC_URL=
# Local development only: allow http://localhost RPC endpoints. Never enable for production or remote RPC endpoints.
ALLOW_INSECURE_LOCAL_RPC=false

# Keypair — one of these required:
# ADMIN_KEYPAIR=[1,2,3,...] (JSON array of 64 bytes — for Railway/Docker deployments)
# ADMIN_KEYPAIR_PATH=/home/user/.config/solana/keypair.json (file path)

# Optional — Supabase auto-discovery (enables dynamic market tracking)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Deployment JSON (if not using Supabase auto-discovery)
DEPLOYMENT_JSON=

# Optional — Tuning
PUSH_INTERVAL_MS=3000
HEALTH_PORT=18810
HEALTH_BIND=0.0.0.0
HEALTH_AUTH_TOKEN=your-secure-bearer-token
MAX_PRICE_MOVE_PCT=10
STALE_THRESHOLD_S=30
# MIN_KEEPER_BALANCE_SOL must convert to at least 1 whole lamport after SOL -> lamports conversion; fractional-lamport values are rejected.
MIN_KEEPER_BALANCE_SOL=0.05
ORACLE_KEEPER_BLOCKED_MARKETS=

# Optional — Price feeds
HERMES_URL=https://hermes.pyth.network
DISCOVERY_INTERVAL_MS=30000

# Optional — chart tick publisher (OFF unless BOTH are set). POSTs each cycle's landed marks
# + raw pool prices to the price-ws ingest endpoint; never blocks or alters pushes.
# TICK_INGEST_URL=https://<price-ws-host>/ingest/ticks   (must be https; http only for localhost, startup throws otherwise)
# TICK_INGEST_KEY=
# TICK_PUBLISH_TIMEOUT_MS=1500

# Optional — v2.1 (P2b) layer: tag 103 allocation cranks, tag 104 ADL wind-down, hedged-lockout alert,
# Earn par-E3 gap in /health. A strict no-op until the wrapper answers a cached tag-103 simulation probe.
# P2B_FEATURES=auto            auto (default; probe decides) | on | off
# P2B_PROBE_SUPPORTED_TTL_MS=3600000
# P2B_PROBE_UNSUPPORTED_TTL_MS=21600000
# P2B_PROBE_RETRY_MS=60000
# P2B_TICK_MS=20000
# P2B_ALLOCATE_INTERVAL_MS=60000      per-market pacing of tag 103
# P2B_ALLOCATE_JITTER_PCT=25
# P2B_ALLOCATE_CU=600000
# P2B_WIND_DOWN_MAX_PER_MARKET=3      tag 104 sends per market per cycle
# P2B_WIND_DOWN_MAX_PER_CYCLE=8
# P2B_WIND_DOWN_MAX_SIMS=6
# P2B_WIND_DOWN_MAX_MARK_AGE_SLOTS=140   (the program refuses above 150)
# P2B_WIND_DOWN_CU=600000
# P2B_WIND_DOWN_COOLDOWN_MS=60000    leave a close-only market alone this long after a turn that sent nothing
# HEDGED_LOCKOUT_UTIL_BPS=9000        both sides >= 90% of N_cap ...
# HEDGED_LOCKOUT_FLAT_BPS=300         ... while |LP net| <= 3% of N_cap
# HEDGED_LOCKOUT_INTERVAL_MS=30000
# EARN_GAP_INTERVAL_MS=60000
# EARN_GAP_ALERT_BPS=100              par - E3 gap (bps) that alerts ...
# EARN_GAP_ALERT_CYCLES=3             ... after this many consecutive checks

# ── Transaction v1 (SIMD-0385/0296) for the PushAuthMark batch — see README "Transaction v1" ──
# off (default) = legacy, byte-identical to before | auto = v1 when the cluster reports it, legacy fallback on a
# format rejection | on = requires the cluster to report v1 (fails closed at detection = config error), but a runtime
# v1 rejection still falls back to legacy for that cycle (never skips a push cycle); use auto in production.
# TX_V1=off
# Max markets per v1 tx (default 16 ~ legacy's 13: an on-chain revert after a clean preflight takes the whole tx).
# 0 = all that fit (bytes/accounts/CU/loaded size), only if set explicitly.
# TX_V1_PUSH_MAX_MARKETS=16
# Re-simulations per cycle spent isolating reverting markets in v1; past it the rest waits a cycle (not struck).
# TX_V1_ISOLATION_MAX_SIMS=8
# TX_V1_PUSH_CU_PER_MARKET=8000
# TX_V1_PUSH_CU_BASE=10000
# Unset = derived per tx: 1.25 x (TX_V1_LOADED_OVERHEAD_BYTES + sum(slab bytes + 64)).
# TX_V1_LOADED_ACCOUNTS_BYTES=
# TX_V1_LOADED_OVERHEAD_BYTES=2000000
# The wrapper's 128 KiB heap (#176; in v1 a config bit). 0 = none, explicitly.
# TX_V1_HEAP_BYTES=131072
# TOTAL priority fee per v1 push tx, in lamports (NOT micro-lamports/CU). Digits only, max 1000000 (0.001 SOL;
# at one tx per 1.5 s that is ~57.6 SOL/day). Default 0.
# TX_V1_PRIORITY_FEE_LAMPORTS=0
# TX_V1_RETRY_AFTER_REJECT_MS=600000
# Landing canary: the first N v1 cycles (and N after each landing suspension) wait for each v1 tx to confirm;
# one that never shows up suspends v1 and its markets are re-pushed in legacy. 0 = no canary.
# TX_V1_CANARY_CYCLES=5
# TX_V1_CANARY_TIMEOUT_MS=10000
